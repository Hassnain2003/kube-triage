# Comma-separated Groq API keys (rotated on 429). Never commit real keys.
# Keys from different orgs give separate TPD buckets.
GROQ_API_KEYS=

# Legacy single key (used if GROQ_API_KEYS is empty)
# GROQ_API_KEY=

# Optional overrides
# Default target is llama-3.3-70b-versatile. Override to a model available on your key.
GROQ_MODEL=llama-3.3-70b-versatile
# Agent (read-only). Fault injection uses your default kubectl context.
KUBECONFIG_TRIAGE=.kube/triage.kubeconfig
KUBE_NAMESPACE=demo
KUBE_TRIAGE_TIMEOUT_SECONDS=180
KUBE_TRIAGE_MAX_TOOL_CALLS=24
