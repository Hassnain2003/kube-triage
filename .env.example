# Groq API key for Llama 3.3 70B. Never commit a real key.
GROQ_API_KEY=

# Optional overrides
# Default is llama-3.3-70b-versatile. Override if that model is not on your Groq key.
GROQ_MODEL=llama-3.3-70b-versatile
# Agent (read-only). Fault injection uses your default kubectl context.
KUBECONFIG_TRIAGE=.kube/triage.kubeconfig
KUBE_NAMESPACE=demo
KUBE_TRIAGE_TIMEOUT_SECONDS=180
KUBE_TRIAGE_MAX_TOOL_CALLS=16
